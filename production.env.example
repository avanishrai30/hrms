# ==============================================================================
# VC ORGANICS ENTERPRISE HRMS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
DOMAIN_NAME=hrms.vcorganics.com

# Database (PostgreSQL 16)
POSTGRES_DB=vc_hrms_prod
POSTGRES_USER=hrms_admin
POSTGRES_PASSWORD=ReplaceWithStrongPostgresPassword2026!
DATABASE_URL=postgresql://hrms_admin:ReplaceWithStrongPostgresPassword2026!@postgres:5432/vc_hrms_prod?schema=public

# In-Memory Cache & Message Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ReplaceWithStrongRedisPassword2026!

# Cryptographic Keys & JWT Security
JWT_SECRET=ReplaceWithAtLeast64CharCryptographicallySecureJwtKey2026!
COOKIE_SECRET=ReplaceWithAtLeast64CharCryptographicallySecureCookieKey2026!

# AI Intelligence & LLM Engine (Google Gemini / OpenAI)
ACTIVE_AI_PROVIDER=GEMINI
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere2026
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHereIfConfigured

# Multi-Tenant & RBAC Settings
DEFAULT_TENANT_ID=tenant-vc-organics-hq
ENABLE_AUDIT_LOGGING=true
ENABLE_PROMPT_SHIELD=true

# Storage & Document Vault (S3 / Local Vault)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/vault
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=vc-hrms-documents-prod
