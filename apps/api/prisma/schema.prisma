  industrySector  String   @default("Manufacturing & Agritech") @map("industry_sector")
  experienceLevel String   @map("experience_level")
  p25Ctc          Float    @map("p25_ctc")
  p50Ctc          Float    @map("p50_ctc")
  p75Ctc          Float    @map("p75_ctc")
  p90Ctc          Float    @map("p90_ctc")
  surveySource    String   @default("Aon Hewitt & Radford") @map("survey_source")
  surveyYear      Int      @default(2026) @map("survey_year")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobTitle])
  @@map("salary_benchmarks")
}
