// ----------------- TASK 11.5: COMPENSATION FOUNDATION MODELS -----------------

enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  INFORMATIONAL
}

enum SalaryComponentCategory {
  BASIC
  HRA
  CONVEYANCE
  MEDICAL
  SPECIAL_ALLOWANCE
  BONUS
  PF
  ESI
  PROFESSIONAL_TAX
  TDS
  CUSTOM
}

enum CompensationCalculationType {
  FLAT_AMOUNT
  PERCENTAGE_OF_BASIC
  PERCENTAGE_OF_GROSS
  FORMULA
}

enum CompensationStatus {
  DRAFT
  ACTIVE
  REVISED
  TERMINATED
}

enum CompensationChangeReason {
  JOINING_SALARY
  ANNUAL_REVISION
  PROMOTION_INCREASE
  MANUAL_ADJUSTMENT
  OTHER
}

model SalaryComponent {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  name             String
  code             String
  type             SalaryComponentType
  category         SalaryComponentCategory
  isTaxable        Boolean                     @default(true) @map("is_taxable")
  isFixed          Boolean                     @default(true) @map("is_fixed")
  calculationType  CompensationCalculationType @default(FLAT_AMOUNT) @map("calculation_type")
  calculationValue Float                       @default(0) @map("calculation_value")
  description      String?
  isActive         Boolean                     @default(true) @map("is_active")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateItems    CompensationTemplateItem[]
  employeeItems    EmployeeCompensationItem[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, category])
  @@map("salary_components")
}

model CompensationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  jobRole     String?  @map("job_role")
  currency    String   @default("INR")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

