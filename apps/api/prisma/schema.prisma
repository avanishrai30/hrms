  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  clientId    String    @map("client_id")
  clientSecretHash String @map("client_secret_hash")
  redirectUris String[] @default([]) @map("redirect_uris")
  scopes      String[]  @default([])
  status      ApiCredentialStatus @default(ACTIVE)
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokens      ApiToken[]

  @@unique([tenantId, clientId])
  @@index([tenantId, status])
  @@map("api_clients")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientIdRef String    @map("client_id_ref") @db.Uuid
  accessTokenHash String @map("access_token_hash")
  refreshTokenHash String? @map("refresh_token_hash")
  scopes      String[]  @default([])
  status      ApiCredentialStatus @default(ACTIVE)
  expiresAt   DateTime  @map("expires_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      ApiClient @relation(fields: [clientIdRef], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, clientIdRef])
  @@map("api_tokens")
}

model ApiUsageLog {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  apiKeyId    String?   @map("api_key_id") @db.Uuid
  path        String
  method      String
  statusCode  Int       @map("status_code")
  latencyMs   Int       @default(0) @map("latency_ms")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKey      ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, apiKeyId])
  @@map("api_usage_logs")
}

model ApiWebhook {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  url         String
  events      String[]  @default([])
  secretHash  String    @map("secret_hash")
  status      ApiCredentialStatus @default(ACTIVE)
  retryCount  Int       @default(3) @map("retry_count")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions ApiSubscription[]

  @@index([tenantId, status])
  @@map("api_webhooks")
}

model ApiSubscription {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  webhookId   String    @map("webhook_id") @db.Uuid
  event       String
  deliveryStatus WebhookDeliveryStatus @default(PENDING) @map("delivery_status")
  attempts    Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError   String?   @map("last_error")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  payload     Json?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook     ApiWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, webhookId])
  @@index([tenantId, event])
  @@index([tenantId, deliveryStatus])
  @@map("api_subscriptions")
}

model AutomationRule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  triggerType String    @map("trigger_type")
  conditions  Json      @default("[]")
  actions     Json      @default("[]")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([tenantId, triggerType])
  @@index([tenantId, isActive])
  @@map("automation_rules")
}

model AutomationRun {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  ruleId      String    @map("rule_id") @db.Uuid
  status      AutomationRunStatus @default(QUEUED)
  triggerPayload Json   @map("trigger_payload")
  actionResults Json    @default("[]") @map("action_results")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, ruleId])
  @@index([tenantId, status])
  @@map("automation_runs")
}

model ExternalIntegration {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  provider    String
  category    IntegrationProviderCategory
  displayName String    @map("display_name")
  status      ApiCredentialStatus @default(ACTIVE)
  encryptedConfig String? @map("encrypted_config")
  scopes      String[]  @default([])
  lastSyncAt  DateTime? @map("last_sync_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@map("external_integrations")
}

model SSOConfiguration {
