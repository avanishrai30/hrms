// ------------------------------------------
// 1. ASSET MANAGEMENT & INVENTORY MODELS
// ------------------------------------------

model AssetCategoryMaster {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  category             AssetCategory @unique
  name                 String
  code                 String
  usefulLifeYears      Int           @default(3) @map("useful_life_years")
  salvageValuePercent  Float         @default(5.0) @map("salvage_value_percent")
  depreciationMethod   DepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([tenantId, category])
  @@map("asset_category_masters")
}

model AssetVendor {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  code         String
  contactName  String?   @map("contact_name")
  email        String?
  phone        String?
  address      String?
  taxId        String?   @map("tax_id")
  rating       Float?    @default(5.0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets       Asset[]
  warranties   AssetWarranty[]
  amcs         AssetAMC[]

  @@index([tenantId, name])
  @@map("asset_vendors")
}

model Asset {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  categoryId           String?            @map("category_id") @db.Uuid
  vendorId             String?            @map("vendor_id") @db.Uuid
  category             AssetCategory      @default(LAPTOP)
  assetCode            String             @map("asset_code")
  serialNumber         String             @map("serial_number")
  name                 String
  model                String?
  brand                String?
  specificationsJson   Json               @default("{}") @map("specifications_json")
  purchaseDate         DateTime           @map("purchase_date")
  purchaseCost         Float              @map("purchase_cost")
  currency             String             @default("INR")
  location             String?
  condition            AssetCondition     @default(BRAND_NEW)
  status               AssetStatus        @default(AVAILABLE)
  currentHolderId      String?            @map("current_holder_id") @db.Uuid
  depreciationMethod   DepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  usefulLifeYears      Int                @default(3) @map("useful_life_years")
  salvageValue         Float              @default(0.0) @map("salvage_value")
  isScrapped           Boolean            @default(false) @map("is_scrapped")
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryMaster  AssetCategoryMaster? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor          AssetVendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments     AssetAssignment[]
  transactions    AssetTransaction[]
  maintenances    AssetMaintenance[]
  warranties      AssetWarranty[]
  amcs            AssetAMC[]
  tickets         Ticket[]

  @@unique([tenantId, assetCode])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([tenantId, currentHolderId])
  @@map("assets")
}

model AssetAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  assetId      String         @map("asset_id") @db.Uuid
  employeeId   String         @map("employee_id") @db.Uuid
  issuedById   String?        @map("issued_by_id") @db.Uuid
  assignedDate DateTime       @default(now()) @map("assigned_date")
  returnedDate DateTime?      @map("returned_date")
  condition    AssetCondition @default(GOOD)
  returnCondition AssetCondition? @map("return_condition")
  agreementUrl String?        @map("agreement_url")
  notes        String?
  isReturned   Boolean        @default(false) @map("is_returned")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation("AssignedTo", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy Employee? @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([tenantId, assetId])
  @@index([tenantId, employeeId])
