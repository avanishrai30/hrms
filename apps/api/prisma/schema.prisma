generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantPlan {
  TRIAL
  STANDARD
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_READONLY
}

enum EmploymentStatus {
  DRAFT
  INVITED
  ACTIVE
  PROBATION
  ON_LEAVE
  NOTICE_PERIOD
  INACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum EmployeeDocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  OFFER_LETTER
  EMPLOYMENT_AGREEMENT
  BANK_DOCUMENT
  TAX_DOCUMENT
  CUSTOM
}

enum EmployeeDocumentStatus {
  DRAFT
  ACTIVE
  REPLACED
  REJECTED
  ARCHIVED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum TenantSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum UsageMetricPeriod {
  DAILY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  HOLIDAY
  WEEK_OFF
  WORK_FROM_HOME
  ON_LEAVE
  PENDING_REVIEW
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  MANUAL_ADJUSTMENT
  STATUS_CHANGE
  CORRECTION_REQUEST
  CORRECTION_APPROVAL
  CORRECTION_REJECTION
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LocationType {
  FACTORY
  OFFICE
  WAREHOUSE
  RETAIL_OUTLET
  DISTRIBUTION_CENTER
  CUSTOM
}

enum LocationVerificationStatus {
  VERIFIED
  OUTSIDE_RADIUS
  ACCURACY_TOO_LOW
  NO_ASSIGNED_LOCATION
  LOCATION_DISABLED
  ASSIGNMENT_EXPIRED
  MANUAL_OVERRIDE
  BYPASS_ALLOWED
}

enum FaceProfileStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum FaceEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum FaceVerificationStatus {
  MATCHED
  MISMATCH
  LOW_CONFIDENCE
  NO_ACTIVE_PROFILE
  SPOOF_DETECTED
  QUALITY_FAILED
  BYPASSED
}

enum LivenessVerificationStatus {
  PASSED
  FAILED
  SUSPICIOUS
  RETAKE_REQUIRED
  CAMERA_ERROR
  TIMEOUT
}

enum LeaveCategory {
  CASUAL
  SICK
  EARNED
  COMPENSATORY_OFF
  MATERNITY
  PATERNITY
  UNPAID
  CUSTOM
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAccrualFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  MANUAL
}

enum LeaveTransactionType {
  ALLOCATION
  MONTHLY_ACCRUAL
  QUARTERLY_ACCRUAL
  YEARLY_ACCRUAL
  USAGE
  CARRY_FORWARD
  EXPIRY
  MANUAL_ADJUSTMENT
  CANCELLATION_REFUND
}

enum SandwichPolicyType {
  NONE
  WEEKENDS_ONLY
  HOLIDAYS_ONLY
  WEEKENDS_AND_HOLIDAYS
}

model Tenant {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  slug         String              @unique
  legalName    String              @map("legal_name")
  status       TenantStatus        @default(ACTIVE)
  plan         TenantPlan          @default(STANDARD)
  primaryDomain String?            @unique @map("primary_domain")
  timezone     String              @default("Asia/Kolkata")
  locale       String              @default("en-IN")
  currency     String              @default("INR")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  archivedAt   DateTime?           @map("archived_at")

  settings     TenantSettings?
  branding     TenantBranding?
  domains      TenantDomain[]
  featureFlags TenantFeatureFlag[]
  memberships  TenantMembership[]
  roles        Role[]
  sessions     Session[]
  departments  Department[]
  designations Designation[]
  employees    Employee[]
  employeeStatusHistory EmployeeStatusHistory[]
  employeeTimelineEvents EmployeeTimelineEvent[]
  shifts       Shift[]
  shiftAssignments ShiftAssignment[]
  workCalendars WorkCalendar[]
  holidayCalendars HolidayCalendar[]
  subscriptions TenantSubscription[]
  usageMetrics UsageMetric[]
  attendances  Attendance[]
  attendanceEvents AttendanceEvent[]
  attendanceCorrections AttendanceCorrection[]
  attendanceRules AttendanceRule?
  attendanceExceptions AttendanceException[]
  attendanceSummaries AttendanceSummary[]
  locations    Location[]
  locationAssignments LocationAssignment[]
  locationVerifications LocationVerification[]
  faceProfiles       FaceProfile[]
  faceEmbeddings     FaceEmbedding[]
  faceEnrollments    FaceEnrollment[]
  faceVerifications  FaceVerification[]
  livenessVerifications LivenessVerification[]
  leaveTypes          LeaveType[]
  leavePolicies       LeavePolicy[]
  leaveBalances       LeaveBalance[]
  leaveAccrualRules   LeaveAccrualRule[]
  leaveTransactions   LeaveAccrualTransaction[]
  leaveRequests       LeaveRequest[]
  leaveApprovals      LeaveApproval[]
  leaveAttachments    LeaveAttachment[]
  holidays            Holiday[]
  salaryComponents    SalaryComponent[]
  compensationTemplates CompensationTemplate[]
  employeeCompensations EmployeeCompensation[]
  employeeCompensationHistories EmployeeCompensationHistory[]
  payrollRuns         PayrollRun[]
  payrollRunEmployees PayrollRunEmployee[]
  payrollComponentBreakdowns PayrollComponentBreakdown[]
  payrollAdjustments  PayrollAdjustment[]
  payrollApprovals    PayrollApproval[]
  payslips            Payslip[]
  payslipDistributions PayslipDistribution[]
  payslipTemplates    PayslipTemplate[]
  complianceRules     ComplianceRule[]
  complianceRuleVersions ComplianceRuleVersion[]
  complianceSnapshots ComplianceSnapshot[]
  reportDefinitions   ReportDefinition[]
  savedReports        SavedReport[]
  reportExecutions    ReportExecution[]
  reportSchedules     ReportSchedule[]
  dashboards          Dashboard[]
  dashboardWidgets    DashboardWidget[]
  analyticsSnapshots  AnalyticsSnapshot[]
  notificationTemplates NotificationTemplate[]
  notifications       Notification[]
  notificationPreferences NotificationPreference[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  workflowStepExecutions WorkflowStepExecution[]
  workflowAudits      WorkflowAudit[]
  approvalTemplates   ApprovalTemplate[]
  approvalRequests    ApprovalRequest[]
  approvalActions     ApprovalAction[]
  businessUnits       BusinessUnit[]
  regions             Region[]
  teams               Team[]
  suspiciousActivities SuspiciousActivity[]
  employeeProfiles    EmployeeProfile[]
  employeeDocuments   EmployeeDocument[]
  employeeRequests    EmployeeRequest[]
  announcements       Announcement[]
  acknowledgements    Acknowledgement[]
  aiConversations     AiConversation[]
  aiMessages          AiMessage[]
  aiKnowledgeDocs     AiKnowledgeDocument[]
  aiKnowledgeChunks   AiKnowledgeChunk[]
  aiPredictions       AiWorkforcePrediction[]
  aiInsights          AiSmartInsight[]
  aiDocumentExtractions AiDocumentExtraction[]
  aiSettings          AiSettings?
  hiringRequests      HiringRequest[]
  jobRequisitions     JobRequisition[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  applications        Application[]
  interviews          Interview[]
  offers              Offer[]
  preboardingTasks    PreboardingTask[]
  recruitmentSources  RecruitmentSource[]
  candidateActivities CandidateActivity[]
  goalCycles          GoalCycle[]
  goals               Goal[]
  feedbacks           Feedback[]
  oneOnOnes           OneOnOne[]
  reviewCycles        ReviewCycle[]
  performanceReviews  PerformanceReview[]
  performanceReviewScores PerformanceReviewScore[]
  competencies        Competency[]
  designationCompetencies DesignationCompetency[]
  employeeCompetencyRatings EmployeeCompetencyRating[]
  calibrationSessions CalibrationSession[]
  salaryIncrementRules SalaryIncrementRule[]
  promotionRecommendations PromotionRecommendation[]
  successionPositions SuccessionPosition[]
  successorPools      SuccessorPool[]
  assets              Asset[]
  assetCategories     AssetCategoryMaster[]
  assetAssignments    AssetAssignment[]
  assetTransactions   AssetTransaction[]
  assetMaintenances   AssetMaintenance[]
  assetAMCs           AssetAMC[]
  assetVendors        AssetVendor[]
  assetWarranties     AssetWarranty[]
  softwareLicenses    SoftwareLicense[]
  licenseAssignments  LicenseAssignment[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  tickets             Ticket[]
  ticketComments      TicketComment[]
  ticketAttachments   TicketAttachment[]
  ticketSLAs          TicketSLA[]
  ticketEscalations   TicketEscalation[]
  facilities          Facility[]
  facilityBookings    FacilityBooking[]
  desks               Desk[]
  deskAllocations     DeskAllocation[]
  vehicles            Vehicle[]
  vehicleBookings     VehicleBooking[]
  vehicleLogs         VehicleLog[]
  visitors            Visitor[]
  visitorVisits       VisitorVisit[]
  visitorPasses       VisitorPass[]
  gatePasses          GatePass[]
  contractors         Contractor[]
  contractorAccesses  ContractorAccess[]
  exitClearances      ExitClearance[]
  clearanceTasks      ClearanceTask[]
  expenseCategoryMasters ExpenseCategoryMaster[]
  expensePolicies     ExpensePolicy[]
  expenseClaims       ExpenseClaim[]
  expenseItems        ExpenseItem[]
  expenseReceipts     ExpenseReceipt[]
  expenseApprovals    ExpenseApproval[]
  expenseAudits       ExpenseAudit[]
  travelRequests      TravelRequest[]
  travelSegments      TravelSegment[]
  travelAdvances      TravelAdvance[]
  travelSettlements   TravelSettlement[]
  costCenters         CostCenter[]
  departmentBudgets   DepartmentBudget[]
  budgetAllocations   BudgetAllocation[]
  accountGroups       AccountGroup[]
  chartOfAccounts     ChartOfAccount[]
  generalLedgerEntries GeneralLedgerEntry[]
  journalEntries      JournalEntry[]
  journalEntryLines   JournalEntryLine[]
  accountingPeriods   AccountingPeriod[]
  vendors             Vendor[]
  vendorBankAccounts  VendorBankAccount[]
  vendorDocuments     VendorDocument[]
  customers           Customer[]
  customerInvoices    CustomerInvoice[]
  customerInvoiceItems CustomerInvoiceItem[]
  customerPayments    CustomerPayment[]
  vendorInvoices      VendorInvoice[]
  vendorInvoiceItems  VendorInvoiceItem[]
  vendorPayments      VendorPayment[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  bankStatements      BankStatement[]
  bankReconciliations BankReconciliation[]
  taxLedgers          TaxLedger[]
  gstReturns          GSTReturn[]
  gstTransactions     GSTTransaction[]
  erpIntegrations     ERPIntegration[]
  erpConnections      ERPConnection[]
  erpJobs             ERPJob[]
  erpJobLogs          ERPJobLog[]
  financialStatementSnapshots FinancialStatementSnapshot[]
  apiScopes           ApiScope[]
  apiKeys             ApiKey[]
  apiClients          ApiClient[]
  apiTokens           ApiToken[]
  apiUsageLogs        ApiUsageLog[]
  apiWebhooks         ApiWebhook[]
  apiSubscriptions    ApiSubscription[]
  automationRules     AutomationRule[]
  automationRuns      AutomationRun[]
  externalIntegrations ExternalIntegration[]
  ssoConfigurations   SSOConfiguration[]
  knowledgeCategories KnowledgeCategory[]
  knowledgeArticles   KnowledgeArticle[]
  knowledgeVersions   KnowledgeVersion[]
  knowledgeAttachments KnowledgeAttachment[]
  marketplaceApps     MarketplaceApp[]
  marketplaceInstalls MarketplaceInstall[]
  trainingCategories  TrainingCategory[]
  trainingCourses     TrainingCourse[]
  courseModules       CourseModule[]
  lessons             Lesson[]
  lessonAttachments   LessonAttachment[]
  courseEnrollments   CourseEnrollment[]
  learningPaths       LearningPath[]
  learningPathCourses LearningPathCourse[]
  learningPathEnrollments LearningPathEnrollment[]
  assessments         Assessment[]
  assessmentQuestions AssessmentQuestion[]
  assessmentAttempts  AssessmentAttempt[]
  lmsCertifications   LmsCertification[]
  employeeCertifications EmployeeCertification[]
  skills              Skill[]
  skillCategories     SkillCategory[]
  employeeSkills      EmployeeSkill[]
  instructors         Instructor[]
  trainingSessions    TrainingSession[]
  sessionAttendances  SessionAttendance[]
  positions           Position[]
  positionAssignments PositionAssignment[]
  headcountPlans      HeadcountPlan[]
  headcountScenarios  HeadcountScenario[]
  workforceCostForecasts WorkforceCostForecast[]
  orgStructureVersions OrgStructureVersion[]
  attritionRiskAssessments AttritionRiskAssessment[]
  skillSupplyDemandForecasts SkillSupplyDemandForecast[]
  biometricDevices    BiometricDevice[]
  biometricPunches    BiometricPunch[]
  deviceSyncLogs      DeviceSyncLog[]
  shiftSwapRequests   ShiftSwapRequest[]
  overtimeRequests    OvertimeRequest[]
  attendanceAnomalies AttendanceAnomaly[]
  contractorAttendances ContractorAttendance[]
  workforceSchedules  WorkforceSchedule[]
  payrollCycles        PayrollCycle[]
  payrollTaxDeclarations PayrollTaxDeclaration[]
  payrollTaxComputations PayrollTaxComputation[]
  payrollSettlements   PayrollSettlement[]
  payrollGratuities    PayrollGratuity[]
  payrollBonuses       PayrollBonus[]
  payrollIncentives    PayrollIncentive[]
  payrollArrears       PayrollArrear[]
  payrollLoans         PayrollLoan[]
  compensationRevisions CompensationRevision[]
  salaryBands          SalaryBand[]
  salaryBenchmarks     SalaryBenchmark[]
  auditLogs           AuditLog[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantSettings {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @unique @map("tenant_id") @db.Uuid
  timezone                   String
  locale                     String
  currency                   String
  weekStartDay               Int      @default(1) @map("week_start_day")
  payrollCycleDay            Int      @default(1) @map("payroll_cycle_day")
  attendanceTimezone         String   @map("attendance_timezone")
  defaultWorkingDaysPerMonth Int      @default(26) @map("default_working_days_per_month")
  metadata                   Json     @default("{}")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantBranding {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  displayName      String   @map("display_name")
  logoObjectKey    String?  @map("logo_object_key")
  faviconObjectKey String?  @map("favicon_object_key")
  primaryColor     String   @default("#1f8f5f") @map("primary_color")
  secondaryColor   String   @default("#335c67") @map("secondary_color")
  accentColor      String   @default("#f2b84b") @map("accent_color")
  pwaName          String   @map("pwa_name")
  pwaShortName     String   @map("pwa_short_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model TenantDomain {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  domain     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantFeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String
  phone        String?
  passwordHash String?            @map("password_hash")
  status       UserStatus         @default(INVITED)
  lastLoginAt  DateTime?          @map("last_login_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  memberships TenantMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  uploadedDocuments DocumentMetadata[]
  employeeStatusChanges EmployeeStatusHistory[]
  employeeTimelineEvents EmployeeTimelineEvent[]
  attendanceEvents AttendanceEvent[]
  requestedCorrections AttendanceCorrection[] @relation("CorrectionRequestedBy")
  reviewedCorrections AttendanceCorrection[] @relation("CorrectionReviewedBy")
  resolvedAttendanceExceptions AttendanceException[] @relation("ExceptionResolvedBy")
  overriddenLocationVerifications LocationVerification[] @relation("LocationOverrideBy")
  enrolledFaceProfiles FaceEnrollment[] @relation("FaceEnrolledBy")
  reviewedFaceProfiles FaceEnrollment[] @relation("FaceReviewedBy")
  leaveApprovals LeaveApproval[]
  approvedCompensations EmployeeCompensation[]
  approvedCompensationHistories EmployeeCompensationHistory[]
  createdPayrollRuns PayrollRun[] @relation("PayrollCreatedBy")
  approvedPayrollRuns PayrollRun[] @relation("PayrollApprovedBy")
  createdPayrollAdjustments PayrollAdjustment[]
  payrollApprovals PayrollApproval[]
  generatedPayslips Payslip[] @relation("PayslipGeneratedBy")
  createdComplianceRuleVersions ComplianceRuleVersion[] @relation("ComplianceRuleVersionCreatedBy")
  createdSavedReports SavedReport[] @relation("SavedReportCreatedBy")
  createdReportDefinitions ReportDefinition[] @relation("ReportDefinitionCreatedBy")
  createdDashboards Dashboard[] @relation("DashboardCreatedBy")
  triggeredReportExecutions ReportExecution[] @relation("ReportExecutionTriggeredBy")
  createdReportSchedules ReportSchedule[] @relation("ReportScheduleCreatedBy")
  dashboardWidgets DashboardWidget[]
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  initiatedWorkflows WorkflowInstance[]
  approvalRequests ApprovalRequest[]
  suspiciousActivities SuspiciousActivity[]
  verifiedEmployeeDocuments EmployeeDocument[] @relation("VerifiedEmployeeDocuments")
  resolvedEmployeeRequests EmployeeRequest[] @relation("ResolvedEmployeeRequests")
  createdAnnouncements Announcement[] @relation("CreatedAnnouncements")
  aiConversations   AiConversation[]
  interviewFeedbacks InterviewFeedback[]
  offerApprovals     OfferApproval[]
  verifiedPreboardingTasks PreboardingTask[] @relation("PreboardingVerifiedBy")
  calibratedSessions CalibrationSession[] @relation("CalibratedBy")
  reviewedCalibrations CalibrationReview[] @relation("CalibrationReviewedBy")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         PlatformRole
  status       UserStatus   @default(ACTIVE)
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("platform_users")
}

model TenantMembership {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  employeeId String?          @map("employee_id") @db.Uuid
  status     MembershipStatus @default(INVITED)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee?            @relation(fields: [employeeId], references: [id])
  roles  TenantMembershipRole[]
  sessions Session[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("tenant_memberships")
}

model Role {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  code         String
  name         String
  description  String?
  isSystemRole Boolean                @default(false) @map("is_system_role")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembershipRole[]
  permissions TenantRolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  resource    String
  action      String
  description String?
  roles       TenantRolePermission[]

  @@map("permissions")
}

model TenantMembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
  @@map("tenant_membership_roles")
}

model TenantRolePermission {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, roleId])
  @@map("tenant_role_permissions")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  membershipId      String    @map("membership_id") @db.Uuid
  refreshTokenHash  String    @map("refresh_token_hash")
  deviceFingerprint String    @map("device_fingerprint")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, membershipId])
  @@index([tenantId, expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  identifier   String
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId, identifier])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designations Designation[]
  employees    Employee[]
  locationAssignments LocationAssignment[]
  teams        Team[]
  hiringRequests HiringRequest[]
  jobRequisitions JobRequisition[]
  calibrationSessions CalibrationSession[]
  positions    Position[]
  headcountPlans HeadcountPlan[]
  workforceCostForecasts WorkforceCostForecast[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  name         String
  code         String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
