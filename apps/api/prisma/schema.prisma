}

// ====================================================
// TASK 27: ENTERPRISE LMS, TRAINING & SKILL INTELLIGENCE
// ====================================================

enum CourseDeliveryType {
  SELF_PACED
  INSTRUCTOR_LED
  CLASSROOM
  VIRTUAL_CLASSROOM
  HYBRID
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  DROPPED
}

enum LessonContentType {
  VIDEO
  DOCUMENT
  INTERACTIVE
  SCORM
}

enum AssessmentType {
  PRE_ASSESSMENT
  POST_ASSESSMENT
  QUIZ
  FINAL_EXAM
  CERTIFICATION_EXAM
}

enum QuestionType {
  SINGLE_CHOICE_MCQ
  MULTIPLE_CHOICE_MCQ
  TRUE_FALSE
  DESCRIPTIVE
}

enum LmsCertificationType {
  INTERNAL
  EXTERNAL
  COMPLIANCE
  PROFESSIONAL
}

enum TrainingSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TrainingCategory {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  icon        String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses     TrainingCourse[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("training_categories")
}

model TrainingCourse {
  id                      String             @id @default(uuid()) @db.Uuid
  tenantId                String             @map("tenant_id") @db.Uuid
  categoryId              String?            @map("category_id") @db.Uuid
  code                    String
  title                   String
  slug                    String
  description             String?
  deliveryType            CourseDeliveryType @default(SELF_PACED) @map("delivery_type")
  difficulty              CourseDifficulty   @default(BEGINNER)
  estimatedDurationMinutes Int               @default(60) @map("estimated_duration_minutes")
  passingScorePercent     Float              @default(70.0) @map("passing_score_percent")
  isMandatory             Boolean            @default(false) @map("is_mandatory")
  isCompliance            Boolean            @default(false) @map("is_compliance")
  validityMonths          Int?               @map("validity_months")
  departmentId            String?            @map("department_id") @db.Uuid
  designationId           String?            @map("designation_id") @db.Uuid
  thumbnailUrl            String?            @map("thumbnail_url")
  publishedAt             DateTime?          @map("published_at")
  isActive                Boolean            @default(true) @map("is_active")
  deletedAt               DateTime?          @map("deleted_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                TrainingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules                 CourseModule[]
  enrollments             CourseEnrollment[]
  learningPathCourses     LearningPathCourse[]
  assessments             Assessment[]
  certifications          LmsCertification[]
  sessions                TrainingSession[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId, categoryId])
  @@index([tenantId, isCompliance])
  @@index([tenantId, isActive])
  @@map("training_courses")
}

model CourseModule {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  courseId      String         @map("course_id") @db.Uuid
  title         String
  description   String?
  sequenceOrder Int            @default(1) @map("sequence_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@index([tenantId, courseId])
  @@map("course_modules")
}

model Lesson {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  moduleId        String            @map("module_id") @db.Uuid
  title           String
  contentType     LessonContentType @default(VIDEO) @map("content_type")
  contentUrl      String?           @map("content_url")
  textContent     String?           @map("text_content")
  durationMinutes Int               @default(10) @map("duration_minutes")
  sequenceOrder   Int               @default(1) @map("sequence_order")
  isMandatory     Boolean           @default(true) @map("is_mandatory")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module          CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments     LessonAttachment[]

  @@index([tenantId, moduleId])
  @@map("lessons")
}

model LessonAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  lessonId      String   @map("lesson_id") @db.Uuid
  name          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  fileType      String?  @map("file_type")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([tenantId, lessonId])
  @@map("lesson_attachments")
}

model CourseEnrollment {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  courseId          String           @map("course_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  status            EnrollmentStatus @default(ENROLLED)
  progressPercent   Float            @default(0.0) @map("progress_percent")
  watchTimeSeconds  Int              @default(0) @map("watch_time_seconds")
  score             Float?
  isPassed          Boolean          @default(false) @map("is_passed")
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  completedAt       DateTime?        @map("completed_at")
  dueDate           DateTime?        @map("due_date")
  assignedByUserId  String?          @map("assigned_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course            TrainingCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attempts          AssessmentAttempt[]

  @@unique([tenantId, courseId, employeeId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("course_enrollments")
}

model LearningPath {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  name            String
  slug            String
  description     String?
  departmentId    String?        @map("department_id") @db.Uuid
  designationId   String?        @map("designation_id") @db.Uuid
  isMandatory     Boolean        @default(false) @map("is_mandatory")
  estimatedHours  Float          @default(10.0) @map("estimated_hours")
  isActive        Boolean        @default(true) @map("is_active")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses         LearningPathCourse[]
  enrollments     LearningPathEnrollment[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("learning_paths")
}

model LearningPathCourse {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  learningPathId  String         @map("learning_path_id") @db.Uuid
  courseId        String         @map("course_id") @db.Uuid
  sequenceOrder   Int            @default(1) @map("sequence_order")
  isMandatory     Boolean        @default(true) @map("is_mandatory")
  createdAt       DateTime       @default(now()) @map("created_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learningPath    LearningPath   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
  @@index([tenantId, learningPathId])
  @@map("learning_path_courses")
}

model LearningPathEnrollment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  learningPathId  String           @map("learning_path_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  status          EnrollmentStatus @default(ENROLLED)
  progressPercent Float            @default(0.0) @map("progress_percent")
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  completedAt     DateTime?        @map("completed_at")
  dueDate         DateTime?        @map("due_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learningPath    LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learningPathId, employeeId])
  @@index([tenantId, employeeId])
  @@map("learning_path_enrollments")
}

model Assessment {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  courseId           String?            @map("course_id") @db.Uuid
  title              String
  type               AssessmentType     @default(QUIZ)
  timeLimitMinutes   Int                @default(30) @map("time_limit_minutes")
  passingPercent     Float              @default(70.0) @map("passing_percent")
  maxAttempts        Int                @default(3) @map("max_attempts")
  randomizeQuestions Boolean            @default(true) @map("randomize_questions")
  negativeMarking    Boolean            @default(false) @map("negative_marking")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course             TrainingCourse?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions          AssessmentQuestion[]
  attempts           AssessmentAttempt[]

  @@index([tenantId, courseId])
  @@map("assessments")
}

