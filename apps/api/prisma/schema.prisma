  calculationValue Float                       @default(0) @map("calculation_value")
  monthlyAmount    Float                       @default(0) @map("monthly_amount")
  annualAmount     Float                       @default(0) @map("annual_amount")
  order            Int                         @default(0)
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  template         CompensationTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  component        SalaryComponent             @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@map("compensation_template_items")
}

model EmployeeCompensation {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  employeeId       String                   @map("employee_id") @db.Uuid
  templateId       String?                  @map("template_id") @db.Uuid
  effectiveFrom    DateTime                 @map("effective_from")
  effectiveTo      DateTime?                @map("effective_to")
  monthlyCtc       Float                    @map("monthly_ctc")
  annualCtc        Float                    @map("annual_ctc")
  currency         String                   @default("INR")
  status           CompensationStatus       @default(ACTIVE)
  reason           CompensationChangeReason @default(JOINING_SALARY)
  notes            String?
  approvedByUserId String?                  @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?                @map("approved_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

