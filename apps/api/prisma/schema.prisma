model Ticket {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  ticketNumber      String           @map("ticket_number")
  title             String
  description       String
  category          TicketCategory   @default(HARDWARE)
  priority          TicketPriority   @default(MEDIUM)
  status            TicketStatus     @default(OPEN)
  source            TicketSource     @default(PORTAL)
  createdById       String           @map("created_by_id") @db.Uuid
  assigneeId        String?          @map("assignee_id") @db.Uuid
  assetId           String?          @map("asset_id") @db.Uuid
  responseDueAt     DateTime?        @map("response_due_at")
  resolutionDueAt   DateTime?        @map("resolution_due_at")
  firstRespondedAt  DateTime?        @map("first_responded_at")
  resolvedAt        DateTime?        @map("resolved_at")
  closedAt          DateTime?        @map("closed_at")
  isSlaBreached     Boolean          @default(false) @map("is_sla_breached")
  reopenCount       Int              @default(0) @map("reopen_count")
  tags              String[]         @default([])
  resolutionNotes   String?          @map("resolution_notes")
  satisfactionScore Int?             @map("satisfaction_score")
  feedbackNotes     String?          @map("feedback_notes")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Employee           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    Employee?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset       Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  comments    TicketComment[]
  attachments TicketAttachment[]
  escalations TicketEscalation[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, category])
  @@index([tenantId, createdById])
  @@index([tenantId, assigneeId])
  @@map("tickets")
}

model TicketComment {
