  @@map("employee_compensation_items")
}

model EmployeeCompensationHistory {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  employeeId        String                   @map("employee_id") @db.Uuid
  compensationId    String?                  @map("compensation_id") @db.Uuid
  previousMonthlyCtc Float                   @map("previous_monthly_ctc")
  previousAnnualCtc Float                    @map("previous_annual_ctc")
  newMonthlyCtc     Float                    @map("new_monthly_ctc")
